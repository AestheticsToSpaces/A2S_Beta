# ================================================
# A2S Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# ── Neon PostgreSQL Database ──
# Get your connection string from https://neon.tech
# Backend (JDBC format for Spring Boot):
DB_URL=jdbc:postgresql://ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# LLM service (standard PostgreSQL connection string):
DATABASE_URL=postgresql://your_neon_user:your_neon_password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── JWT Secret ──
# Generate a random 64-char string for production
JWT_SECRET=change-me-to-a-random-64-character-string-for-production-use

# ── CORS ──
# Comma-separated frontend URLs allowed to call the backend
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Google Gemini API ──
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── Groq API (optional, enhances LLM reasoning) ──
# Get your key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# ── LLM Service URL (used by Spring Boot backend to call Flask) ──
LLM_SERVICE_URL=http://localhost:5001

# ── OAuth2 (optional, for Google/Apple login) ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
OAUTH2_REDIRECT_URI=http://localhost:3000/login
